# ---- Database (Supabase Free) ----
# Pooled connection (port 6543) used by the API at runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) used only by `prisma migrate`
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth ----
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Use ONE of the following to verify access tokens in the API:
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_JWT_SECRET="legacy-hs256-secret"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="public-anon-key"

# ---- API ----
API_PORT=4000
API_CORS_ORIGINS="http://localhost:3000"
# mock = clearly-labelled mock data. No "official" mode exists until UPES authorises access.
UPES_CONNECTOR_MODE="mock"

# ---- Optional grounded policy answers (server-only; requires an OpenAI API project/key) ----
# When both values are set, retrieved policy passages can be sent to the Responses API.
# Device-only excerpts are sent only if the student explicitly opts in on the Policy screen.
# OPENAI_API_KEY="replace-with-server-secret"
# OPENAI_MODEL="your-enabled-model"
